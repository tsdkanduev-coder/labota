// OpenClaw configuration for Nabu concierge assistant.
// Based on production config (2026-03-03) + multi-user isolation patches.
// Secrets use ${ENV_VAR} syntax — set them in Render environment variables.
// JSON5 format (comments + trailing commas allowed).
{
  // ─── Browser ────────────────────────────────────────────────
  "browser": {
    "enabled": false,
    "defaultProfile": "openclaw"
  },

  // ─── Agent defaults ─────────────────────────────────────────
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-4.1"
      },
      "compaction": {
        "mode": "safeguard"
      },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      },
      "sandbox": {
        "browser": {
          "allowHostControl": false
        }
      }
    }
  },

  // ─── Tool policy ──────────────────────────────────────────
  // profile: "full" + deny list — allows plugin tools while blocking dangerous core tools
  "tools": {
    "profile": "full",
    "deny": [
      "exec",
      "process",
      "gateway",
      "nodes",
      "browser",
      "canvas",
      "sessions_list",
      "sessions_history",
      "sessions_send",
      "sessions_spawn",
      "subagents",
      "memory_search",
      "memory_get"
    ],
    "web": {
      "search": {
        "enabled": true,
        "provider": "brave",
        "apiKey": "${BRAVE_API_KEY}",
        "maxResults": 5,
        "timeoutSeconds": 30,
        "cacheTtlMinutes": 15
      },
      "fetch": {
        "enabled": true
      }
    },
    "media": {
      "audio": {
        "enabled": true,
        "models": [
          {
            "provider": "openai",
            "model": "gpt-4o-mini-transcribe"
          }
        ]
      }
    }
  },

  // ─── Messages & TTS ──────────────────────────────────────
  "messages": {
    "ackReactionScope": "group-mentions",
    "tts": {
      "auto": "inbound",
      "provider": "openai",
      "openai": {
        "model": "gpt-4o-mini-tts",
        "voice": "shimmer"
      }
    }
  },

  // ─── Commands ────────────────────────────────────────────
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },

  // ─── Channels ────────────────────────────────────────────
  // PATCH: dmPolicy "pairing" → "open" for multi-user access
  "channels": {
    "telegram": {
      "enabled": true,
      "commands": { "native": false, "nativeSkills": false },
      "dmPolicy": "open",
      "allowFrom": ["*"],
      "groupPolicy": "allowlist",
      "streamMode": "off",
      "groups": {
        "*": {
          "requireMention": true,
          "systemPrompt": "Ты — Nabu, персональный консьерж-ассистент. В групповых чатах следуй тем же правилам, что и в DM (см. SOUL.md). Отвечай только когда упомянут. Будь краток."
        }
      }
    }
  },

  // ─── Session isolation (PATCH: added for multi-user) ─────
  "session": {
    "dmScope": "per-account-channel-peer"
  },

  // ─── Gateway ─────────────────────────────────────────────
  "gateway": {
    "nodes": {
      "browser": {
        "mode": "off",
        "node": "vps-browser-node"
      }
    }
  },

  // ─── Plugins ─────────────────────────────────────────────
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      },
      "nabu-calendar": {
        "enabled": true,
        "config": {
          "enabled": true,
          "writeEnabled": true
        }
      },
      "voice-call": {
        "enabled": true,
        "config": {
          "provider": "voximplant",
          "fromNumber": "+79011475193",
          "voximplant": {
            "managementJwt": "${VOXIMPLANT_MANAGEMENT_JWT}",
            "ruleId": "${VOXIMPLANT_RULE_ID}",
            "webhookSecret": "${VOXIMPLANT_WEBHOOK_SECRET}"
          },
          "streaming": {
            "enabled": true,
            "streamPath": "/voice/stream",
            "silenceDurationMs": 300,
            "vadThreshold": 0.85,
            "mode": "realtime-conversation",
            "realtimeModel": "gpt-realtime-1.5",
            "assistantVoice": "cedar",
            "bargeInOnSpeechStart": false,
            "assistantInstructions": "Ты — ассистент, который прямо сейчас звонит по телефону от имени клиента. Говори по-русски, коротко и естественно, как обычный человек в телефонном разговоре. Поздоровайся, объясни зачем звонишь, слушай собеседника и отвечай по делу."
          },
          "publicUrl": "https://openclaw-1zxd.onrender.com/voice/webhook",
          "maxConcurrentCalls": 20,
          "outbound": {
            "defaultMode": "conversation",
            "notifyHangupDelaySec": 3
          },
          "maxDurationSeconds": 300
        }
      }
    }
  }
}
